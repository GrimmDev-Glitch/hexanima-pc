{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexAnima",
  "version": "0.1.4",
  "identifier": "com.grimmdev.hexanima.pc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HexAnima",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#1B172F",
        "center": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:* https://image.civitai.com https://*.civitai.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
